# Anthropic (primary business analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
# Only required if your API key is an "identity-linked" key that errors with
# "anthropic-workspace-id is required...". Find it in the Anthropic Console
# under your organization's workspace settings / the workspace URL.
ANTHROPIC_WORKSPACE_ID=

# OpenAI (Mongolian translation only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Development mode: when true, backend returns realistic mock AI output
# instead of calling Anthropic/OpenAI. Use this to test the full UI for free.
USE_MOCK_AI=false

# TEMPORARY workaround only: when true, OpenAI performs BOTH the English
# analysis and the Mongolian translation, bypassing Anthropic entirely.
# Use this only if Anthropic access is unavailable (e.g. a workspace-id
# issue) - set back to false to restore the normal Claude+OpenAI split
# the assignment spec describes.
USE_OPENAI_FOR_ANALYSIS=false

# Backend upload limits
MAX_UPLOAD_MB=15

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
