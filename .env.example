# Anthropic (primary business analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
# Only required if your API key is an "identity-linked" key that errors with
# "anthropic-workspace-id is required...". Find it in the Anthropic Console
# under your organization's workspace settings / the workspace URL.
ANTHROPIC_WORKSPACE_ID=

# OpenAI (Mongolian translation only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Development mode: when true, backend returns realistic mock AI output
# instead of calling Anthropic/OpenAI. Use this to test the full UI for free.
USE_MOCK_AI=false

# TEMPORARY workaround only: when true, OpenAI performs BOTH the English
# analysis and the Mongolian translation, bypassing Anthropic entirely.
# Use this only if Anthropic access is unavailable (e.g. a workspace-id
# issue) - set back to false to restore the normal Claude+OpenAI split
# the assignment spec describes.
USE_OPENAI_FOR_ANALYSIS=false

# Backend upload limits
MAX_UPLOAD_MB=15

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Authentication -------------------------------------------------------
# Every analysis endpoint requires login. Accounts are created by an
# administrator only (no self sign-up). The first administrator is created
# from these two values when the user store is still empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Where accounts (salted password hashes) are stored, relative to backend/.
USERS_FILE=data/users.json
# Optional fixed secret for signing login tokens. If empty, a random secret
# is generated once and persisted in USERS_FILE.
AUTH_SECRET=
# Login token lifetime in hours.
AUTH_TOKEN_HOURS=12
# Set to true only for local demos/tests: opens the API without any login.
AUTH_DISABLED=false

# --- Deployment (docker-compose / Dokploy) -----------------------------------
# Public URL of the backend, baked into the frontend at build time. Leave empty
# to call /api on the same origin (route /api/* to the backend in the proxy).
NEXT_PUBLIC_API_BASE_URL=https://api.densmaa.example.mn
